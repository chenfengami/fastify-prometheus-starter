{
  "name": "fastify-prometheus-starter",
  "version": "1.0.0",
  "private": true,
  "description": "An extensible business metrics reporting starter built with Fastify, Zod and Prometheus.",
  "author": "chenfengami",
  "license": "MIT",
  "packageManager": "pnpm@8.15.9",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit -p tsconfig.test.json && tsdown",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@prometheus-io/client": "0.16.1",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "6.0.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "tsdown": "0.23.1",
    "vitest": "5.0.3"
  }
}
